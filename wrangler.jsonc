{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timekeeper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.woff"],
      "fallthrough": true,
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timekeeper",
      "database_id": "e4818748-ec9a-4008-b935-872677c0f4ac",
      "migrations_dir": "migrations-d1",
    },
  ],
  "triggers": {
    "crons": ["0 10 * * FRI", "5 14 * * SUN", "5 14 * * *", "15 16 * * *", "*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "versatileaccounting.com.au",
    "ADMIN_EMAILS": "alexg@versatileaccounting.com.au,brendong@versatileaccounting.com.au",
    "REPORT_VIEWER_EMAILS": "suzieg@versatileaccounting.com.au",
    "WEEKLY_REPORT_RECIPIENTS": "suzieg@versatileaccounting.com.au,alexg@versatileaccounting.com.au,brendong@versatileaccounting.com.au",
    "FYI_API_BASE_URL": "https://api-ap-southeast-2.fyi.app/external",
    "XERO_ENABLED": "false",
    "XERO_REVIEWER_EMAILS": "suzieg@versatileaccounting.com.au",
    "RUNNING_TIMER_ALERT_HOURS": "12",
    "LONG_ENTRY_ALERT_HOURS": "16",
  },
}
