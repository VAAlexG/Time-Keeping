{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timekeeper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timekeeper",
      "database_id": "e4818748-ec9a-4008-b935-872677c0f4ac",
      "migrations_dir": "migrations-d1",
    },
  ],
  "triggers": {
    "crons": ["5 14 * * SUN", "15 16 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "versatileaccounting.com.au",
    "ADMIN_EMAILS": "alexg@versatileaccounting.com.au,brendong@versatileaccounting.com.au",
    "FYI_API_BASE_URL": "https://api-ap-southeast-2.fyi.app/external",
    "RUNNING_TIMER_ALERT_HOURS": "12",
    "LONG_ENTRY_ALERT_HOURS": "16",
  },
  "secrets": {
    "required": [
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
      "RESEND_API_KEY",
      "EMAIL_FROM",
      "WEEKLY_REPORT_RECIPIENT",
      "REPORT_TEST_RECIPIENT",
    ],
  },
}
