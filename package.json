{
  "name": "time-keeping",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir .wrangler-dist",
    "deploy": "npm run build:client && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:create": "wrangler d1 create timekeeper",
    "db:migrate:local": "wrangler d1 migrations apply timekeeper --local",
    "db:migrate": "wrangler d1 migrations apply timekeeper --remote",
    "password:hash": "tsx scripts/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "^4.9.6",
    "luxon": "^3.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.34.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^7.29.0",
    "uuid": "^11.1.1"
  }
}
